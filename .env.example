# ========================================
# CONFIGURACIÓN DE PUERTOS - PUNTO CENTRAL
# ========================================
# Para cambiar los puertos del backend y frontend. 
# NO es necesario editar otros archivos.
#
BACKEND_PORT=3000     # Puerto expuesto del backend (cambiar aquí para deploy)
FRONTEND_PORT=8080    # Puerto expuesto del frontend (cambiar aquí para deploy)

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
# URL de conexión a PostgreSQL (Supabase)
DATABASE_URL=postgresql://user:password@host:port/database

# Secret para sesiones Express
SESSION_SECRET=your_secret_key_here

# ========================================
# CONFIGURACIÓN DE ALMACENAMIENTO (MinIO)
# ========================================
# Endpoint de MinIO/S3
MINIO_DEFAULT_REGION=us-east-1
MINIO_ENDPOINT=https://rume.uct.cl/
MINIO_USE_PATH_STYLE_ENDPOINT=true
MINIO_BUCKET=innovacion-asistentevirtual-dev

# Credenciales MinIO
DEV_ASISTENTEVIRTUAL_MINIO_ACCESS_KEY_ID=your_access_key
DEV_ASISTENTEVIRTUAL_MINIO_SECRET_ACCESS_KEY=your_secret_key
DEV_ASISTENTEVIRTUAL_MINIO_BUCKET=innovacion-asistentevirtual-dev
